# Determine SoPlasmaFoam root directory (one level above this file)
export SoPlasmaFoam=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
alias SoPlasmaFoam='cd "$SoPlasmaFoam"'

export SoPlasmaFoam_ETC="$SoPlasmaFoam/etc"

export SoPlasmaFoam_TUTORIALS="$SoPlasmaFoam/tutorials"

export SoPlasmaFoam_SRC="$SoPlasmaFoam/src"

export SoPlasmaFoam_THIRD_PARTY="$SoPlasmaFoam/ThirdParty"
